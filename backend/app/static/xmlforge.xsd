<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:simpleType name="booleanString">
    <xs:restriction base="xs:string">
      <xs:enumeration value="true"/><xs:enumeration value="false"/>
      <xs:enumeration value="1"/><xs:enumeration value="0"/>
      <xs:enumeration value="yes"/><xs:enumeration value="no"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="statusType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="ACTIVE"/><xs:enumeration value="ARCHIVED"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="scopeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="PERSONAL"/><xs:enumeration value="COMMON"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="cellType" mixed="true">
    <xs:attribute name="column" type="xs:string" use="required"/>
    <xs:attribute name="null" type="booleanString" use="optional" default="false"/>
  </xs:complexType>
  <xs:complexType name="rowType">
    <xs:sequence><xs:element name="cell" type="cellType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
    <xs:attribute name="uuid" type="xs:string" use="optional"/>
    <xs:attribute name="internal_id" type="xs:integer" use="optional"/>
  </xs:complexType>
  <xs:complexType name="rowsType">
    <xs:sequence><xs:element name="row" type="rowType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
  </xs:complexType>

  <xs:complexType name="columnType">
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="type" type="xs:string" use="required"/>
    <xs:attribute name="length" type="xs:string" use="optional" default="-"/>
    <xs:attribute name="nullable" type="booleanString" use="optional" default="true"/>
    <xs:attribute name="primary_key" type="booleanString" use="optional" default="false"/>
    <xs:attribute name="primaryKey" type="booleanString" use="optional"/>
    <xs:attribute name="foreign_key" type="booleanString" use="optional" default="false"/>
    <xs:attribute name="foreignKey" type="booleanString" use="optional"/>
    <xs:attribute name="references" type="xs:string" use="optional"/>
    <xs:attribute name="on_delete" type="xs:string" use="optional"/>
    <xs:attribute name="on_update" type="xs:string" use="optional"/>
    <xs:attribute name="unique" type="booleanString" use="optional" default="false"/>
    <xs:attribute name="auto_increment" type="booleanString" use="optional" default="false"/>
    <xs:attribute name="autoIncrement" type="booleanString" use="optional"/>
    <xs:attribute name="next_auto_increment" type="xs:integer" use="optional"/>
    <xs:attribute name="index" type="booleanString" use="optional" default="false"/>
    <xs:attribute name="default" type="xs:string" use="optional"/>
    <xs:attribute name="comment" type="xs:string" use="optional"/>
    <xs:attribute name="uuid" type="xs:string" use="optional"/>
    <xs:attribute name="internal_id" type="xs:integer" use="optional"/>
    <xs:attribute name="status" type="statusType" use="optional" default="ACTIVE"/>
    <xs:attribute name="creator_id" type="xs:integer" use="optional"/>
    <xs:attribute name="creator_name" type="xs:string" use="optional"/>
    <xs:attribute name="created_at" type="xs:string" use="optional"/>
    <xs:attribute name="updated_at" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:complexType name="columnsType">
    <xs:sequence><xs:element name="column" type="columnType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
  </xs:complexType>

  <xs:complexType name="indexColumnType"><xs:attribute name="name" type="xs:string" use="required"/></xs:complexType>
  <xs:complexType name="indexType">
    <xs:sequence><xs:element name="column" type="indexColumnType" minOccurs="1" maxOccurs="unbounded"/></xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="unique" type="booleanString" use="optional" default="false"/>
  </xs:complexType>
  <xs:complexType name="indexesType"><xs:sequence><xs:element name="index" type="indexType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence></xs:complexType>

  <xs:complexType name="constraintColumnType"><xs:attribute name="name" type="xs:string" use="required"/></xs:complexType>
  <xs:complexType name="namedColumnsConstraintType">
    <xs:sequence><xs:element name="column" type="constraintColumnType" minOccurs="1" maxOccurs="unbounded"/></xs:sequence>
    <xs:attribute name="name" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:complexType name="foreignKeyConstraintType">
    <xs:sequence><xs:element name="column" type="constraintColumnType" minOccurs="1" maxOccurs="unbounded"/></xs:sequence>
    <xs:attribute name="name" type="xs:string" use="optional"/>
    <xs:attribute name="references_table" type="xs:string" use="required"/>
    <xs:attribute name="references_columns" type="xs:string" use="required"/>
    <xs:attribute name="on_delete" type="xs:string" use="optional"/>
    <xs:attribute name="on_update" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:complexType name="constraintsType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="primary-key" type="namedColumnsConstraintType"/>
      <xs:element name="unique" type="namedColumnsConstraintType"/>
      <xs:element name="foreign-key" type="foreignKeyConstraintType"/>
    </xs:choice>
  </xs:complexType>

  <xs:complexType name="tableType">
    <xs:sequence>
      <xs:element name="columns" type="columnsType" minOccurs="0"/>
      <xs:element name="constraints" type="constraintsType" minOccurs="0"/>
      <xs:element name="indexes" type="indexesType" minOccurs="0"/>
      <xs:element name="rows" type="rowsType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="description" type="xs:string" use="optional"/>
    <xs:attribute name="protected" type="booleanString" use="optional" default="false"/>
    <xs:attribute name="file_identifier" type="xs:string" use="optional"/>
    <xs:attribute name="comment" type="xs:string" use="optional"/>
    <xs:attribute name="archived" type="booleanString" use="optional" default="false"/>
    <xs:attribute name="status" type="statusType" use="optional" default="ACTIVE"/>
    <xs:attribute name="uuid" type="xs:string" use="optional"/>
    <xs:attribute name="internal_id" type="xs:integer" use="optional"/>
    <xs:attribute name="creator_id" type="xs:integer" use="optional"/>
    <xs:attribute name="creator_name" type="xs:string" use="optional"/>
    <xs:attribute name="created_at" type="xs:string" use="optional"/>
    <xs:attribute name="updated_at" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="databaseType">
    <xs:sequence><xs:element name="table" type="tableType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="description" type="xs:string" use="optional"/>
    <xs:attribute name="comment" type="xs:string" use="optional"/>
    <xs:attribute name="uuid" type="xs:string" use="optional"/>
    <xs:attribute name="internal_id" type="xs:integer" use="optional"/>
    <xs:attribute name="status" type="statusType" use="optional" default="ACTIVE"/>
    <xs:attribute name="scope" type="scopeType" use="optional" default="PERSONAL"/>
    <xs:attribute name="owner_id" type="xs:integer" use="optional"/>
    <xs:attribute name="version" type="xs:positiveInteger" use="optional" default="1"/>
    <xs:attribute name="generator" type="xs:string" use="optional"/>
    <xs:attribute name="created_at" type="xs:string" use="optional"/>
    <xs:attribute name="author" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:element name="database" type="databaseType"/>
  <xs:element name="table" type="tableType"/>
  <xs:element name="tables"><xs:complexType><xs:sequence><xs:element name="table" type="tableType" maxOccurs="unbounded"/></xs:sequence></xs:complexType></xs:element>
</xs:schema>
