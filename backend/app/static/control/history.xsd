<?xml version="1.0" encoding="UTF-8"?>
<!--
  Control Plane XML — history.xsd (Phase 6B)
  Document : history.xml (historique métier V2 : before/after).
  before_data / after_data : texte (JSON sérialisé) ou élément absent = NULL.
  Les champs action_type / element_type / element_name sont des chaînes libres
  (liste réelle évolutive dans HistoryService) : pas d'enum artificiel.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <xs:complexType name="entryType">
    <xs:sequence>
      <xs:element name="description" type="xs:string" minOccurs="0"/>
      <xs:element name="before_data" type="xs:string" minOccurs="0"/>
      <xs:element name="after_data" type="xs:string" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="internal_id" type="xs:integer" use="required"/>
    <xs:attribute name="uuid" type="xs:string" use="optional"/>
    <xs:attribute name="user_id" type="xs:integer" use="required"/>
    <xs:attribute name="user_name" type="xs:string" use="required"/>
    <xs:attribute name="action_type" type="xs:string" use="required"/>
    <xs:attribute name="element_type" type="xs:string" use="required"/>
    <xs:attribute name="element_name" type="xs:string" use="required"/>
    <xs:attribute name="ip_address" type="xs:string" use="optional"/>
    <xs:attribute name="database_id" type="xs:integer" use="optional"/>
    <xs:attribute name="table_id" type="xs:integer" use="optional"/>
    <xs:attribute name="created_at" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:element name="history">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="entries" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="entry" type="entryType" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="version" type="xs:positiveInteger" use="required"/>
    </xs:complexType>

    <xs:key name="historyEntryIdKey">
      <xs:selector xpath="entries/entry"/>
      <xs:field xpath="@internal_id"/>
    </xs:key>
  </xs:element>

</xs:schema>
