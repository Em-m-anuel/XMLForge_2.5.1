# ============================================================
# XMLForge — configuration XML-only (Phase 6J-B)
# XML est l'unique source de vérité (Control Plane + Data Plane).
# SQLite / SQLAlchemy / projection SQLite : RETIRÉS du runtime.
# ============================================================

# Flask
SECRET_KEY=change-this-secret-key
JWT_SECRET_KEY=change-this-jwt-secret
JWT_EXPIRES_HOURS=24

# Serveur HTTP (défauts : 0.0.0.0:5000)
XMLFORGE_HTTP_HOST=0.0.0.0
XMLFORGE_HTTP_PORT=5000

# ============================================================
# Données runtime (préparation packaging Windows)
# En mode gelé (EXE), les données vont automatiquement sous :
#   %LOCALAPPDATA%\XMLForge\  (Windows) ou ~/.local/share/XMLForge
# Surcharge explicite (tests / installation personnalisée) :
#   XMLFORGE_DATA_DIR=   -> racine unique (data/, tmp/, logs/, config/)
#   XMLFORGE_CONFIG_FOLDER= / XMLFORGE_LOG_FOLDER= / XMLFORGE_FRONTEND_DIST=
# ============================================================
XMLFORGE_DATA_DIR=

# Logs fichier : auto en mode gelé ; forcer en source : XMLFORGE_FILE_LOGS=true
XMLFORGE_FILE_LOGS=

# Frontend buildé à servir par Flask (laisser vide = détection auto)
XMLFORGE_FRONTEND_DIST=

# Stockage XML persistant (laisser vide = backend/data/xml en dev)
XML_STORAGE_FOLDER=

# Dossier privé du Control Plane XML (laisser vide = backend/data/control en dev)
CONTROL_STORAGE_FOLDER=

# Audit XML rotatif
AUDIT_RETENTION_MONTHS=24
AUDIT_COMPRESS_OLD_MONTHS=true

# Niveau d'accès collectif par défaut des bases COMMON : VIEW | EDIT | MANAGE
COMMON_PERMISSION_DEFAULT=VIEW

# Serveur TCP/IP
TCP_ENABLED=true
TCP_HOST=0.0.0.0
TCP_PORT=3307
TCP_SESSION_TIMEOUT_MINUTES=30

# Serveur local uniquement (utiliser un vrai WSGI en production)
ALLOW_UNSAFE_WERKZEUG=true

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================
# Installation vierge (aucun SQLite requis) :
#   1. flask xml-bootstrap   # crée security.xml (rôles admin/user), catalog.xml, history.xml
#   2. flask create-admin    # premier compte administrateur
#   3. python run.py
#
# Ou, en une seule commande non interactive (premier lancement installé) :
#   flask init-app --email <EMAIL> --name <NOM> --password <MOT_DE_PASSE>
# (équivaut à : dossiers runtime + secrets persistants + bootstrap + admin)
# ============================================================
