<?xml version="1.0" encoding="UTF-8"?>

<database
    name="Bibliotheque"
    description="Projet de démonstration XMLForge">

    <!-- ============================= -->
    <!-- TABLE UTILISATEURS -->
    <!-- ============================= -->

    <table
        name="users"
        description="Liste des utilisateurs"
        >

        <columns>

            <column
                name="id"
                type="INT"
                primary_key="true"
                auto_increment="true"
                nullable="false"/>

            <column
                name="fullname"
                type="VARCHAR"
                length="150"
                nullable="false"/>

            <column
                name="email"
                type="VARCHAR"
                length="255"
                unique="true"
                nullable="false"/>

            <column
                name="password"
                type="VARCHAR"
                length="255"
                nullable="false"/>

            <column
                name="created_at"
                type="DATETIME"/>

        </columns>

        <rows>

            <row>
                <cell column="id">1</cell>
                <cell column="fullname">Nyx Ulrich</cell>
                <cell column="email">admin@example.com</cell>
                <cell column="password">********</cell>
                <cell column="created_at">2026-07-24 10:00:00</cell>
            </row>

            <row>
                <cell column="id">2</cell>
                <cell column="fullname">Alice Martin</cell>
                <cell column="email">alice@test.com</cell>
                <cell column="password">********</cell>
                <cell column="created_at">2026-07-24 11:15:00</cell>
            </row>

        </rows>

    </table>

    <!-- ============================= -->
    <!-- TABLE CATEGORIES -->
    <!-- ============================= -->

    <table
        name="categories"
        description="Catégories de livres">

        <columns>

            <column
                name="id"
                type="INT"
                primary_key="true"
                auto_increment="true"/>

            <column
                name="name"
                type="VARCHAR"
                length="100"/>

        </columns>

        <rows>

            <row>
                <cell column="id">1</cell>
                <cell column="name">Informatique</cell>
            </row>

            <row>
                <cell column="id">2</cell>
                <cell column="name">Science</cell>
            </row>

            <row>
                <cell column="id">3</cell>
                <cell column="name">Roman</cell>
            </row>

        </rows>

    </table>

    <!-- ============================= -->
    <!-- TABLE LIVRES -->
    <!-- ============================= -->

    <table
        name="books"
        description="Catalogue des livres">

        <columns>

            <column
                name="id"
                type="INT"
                primary_key="true"
                auto_increment="true"/>

            <column
                name="title"
                type="VARCHAR"
                length="200"
                nullable="false"/>

            <column
                name="author"
                type="VARCHAR"
                length="150"/>

            <column
                name="category_id"
                type="INT"
                foreign_key="true"
                references="categories(id)"/>

            <column
                name="price"
                type="DECIMAL"
                length="10,2"/>

            <column
                name="available"
                type="BOOLEAN"
                default="true"/>

        </columns>

        <rows>

            <row>
                <cell column="id">1</cell>
                <cell column="title">Apprendre Python</cell>
                <cell column="author">John Doe</cell>
                <cell column="category_id">1</cell>
                <cell column="price">25000</cell>
                <cell column="available">true</cell>
            </row>

            <row>
                <cell column="id">2</cell>
                <cell column="title">Le Petit Prince</cell>
                <cell column="author">Antoine de Saint-Exupéry</cell>
                <cell column="category_id">3</cell>
                <cell column="price">12000</cell>
                <cell column="available">false</cell>
            </row>

        </rows>

    </table>

</database>