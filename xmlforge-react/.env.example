# URL REST. /api utilise le proxy Vite en développement et la même origine en production.
VITE_API_URL=/api
# Socket.IO reste sur l'origine Flask en développement.
VITE_SOCKET_URL=http://localhost:5000
# Optionnel : REST est complet. Activer seulement si Socket.IO est exposé/testé.
VITE_ENABLE_SOCKET_IO=false
