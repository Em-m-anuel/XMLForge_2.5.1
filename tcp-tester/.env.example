# 🔗 Serveur TCP XMLForge - Configuration

# Adresse et port du serveur TCP
TCP_HOST=127.0.0.1
TCP_PORT=3307

# Credentials (obtenir depuis l'interface XMLForge, page API & TCP/IP)
TCP_USERNAME=user@example.com
TCP_PASSWORD=your_password_here

# Base de données (optionnel : nom ou ID)
TCP_DATABASE=

# Port de l'app Express
APP_PORT=3000

# Mode debug
DEBUG=true

# Moteur de requêtes (valeurs par défaut du sélecteur de l'interface) :
#   sqlite  -> projection SQLite (moteur historique, défaut)
#   xml     -> moteur XML natif (lecture/écriture directe sur le fichier XML)
#   compare -> exécute la requête sur les deux moteurs et compare les résultats
# Ces valeurs ne remplacent pas le champ "engine" du protocole TCP : elles
# servent simplement à pré-remplir l'interface.
