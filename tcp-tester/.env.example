# 🔗 Serveur TCP XMLForge - Configuration

# Adresse et port du serveur TCP
TCP_HOST=127.0.0.1
TCP_PORT=3307

# Credentials (obtenir depuis l'interface XMLForge)
TCP_USERNAME=user@example.com
TCP_PASSWORD=your_password_here

# Base de données (optionnel)
TCP_DATABASE=

# Port de l'app Express
APP_PORT=3000

# Mode debug
DEBUG=true
